/* ★ 8155 – rofi */

configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    icon-theme:          "WhiteSur-dark";
    display-drun:        "★";
    display-run:         "run";
    display-window:      "fenster";
    drun-display-format: "{name}";
    font:                "JetBrainsMono Nerd Font 10.5";
}

// Farben (accent, accent-soft, cream, muted, faint, ink, hairline, panel) aus dem aktiven Farbthema,
// umgeschaltet von ~/.config/hypr/scripts/thema.sh
@import "~/.config/hypr/themen/aktiv/rofi.rasi"

* {
    background-color: transparent;
    text-color:       @cream;
}

window {
    location:         center;
    width:            560px;
    border:           1px;
    border-color:     @hairline;
    border-radius:    12px;
    background-color: @panel;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing:  10px;
    padding:  14px;
}

inputbar {
    children:         [ prompt, entry ];
    spacing:          10px;
    padding:          8px 12px;
    border:           1px;
    border-color:     @hairline;
    border-radius:    8px;
    background-color: #ffffff0b;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder:       "suchen …";
    placeholder-color: @faint;
    cursor-color:      @accent-soft;
}

message {
    padding:          6px 10px;
    border-radius:    6px;
    background-color: #ffffff08;
}

textbox {
    text-color: @muted;
}

listview {
    border:       0px;
    lines:        8;
    spacing:      2px;
    scrollbar:    false;
    fixed-height: false;
}

element {
    padding:       6px 10px;
    spacing:       10px;
    border-radius: 6px;
}

element normal.normal, element alternate.normal, element normal.active, element alternate.active {
    background-color: transparent;
    text-color:       @cream;
}

element selected.normal, element selected.active {
    background-color: @accent;
    text-color:       @ink;
}

element-icon {
    size:             18px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}
