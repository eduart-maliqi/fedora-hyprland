    accent:      #a100ff;
    accent-soft: #dcafff;
    cream:       #ece6f5;
    muted:       #aaa3ba;
    faint:       #736b85;
    ink:         #100820;
    hairline:    #f0e6ff17;
    panel:       #160c2ab8;
}
